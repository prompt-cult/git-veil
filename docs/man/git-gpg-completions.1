.TH git-gpg-completions 1  "git-gpg-completions " 
.SH NAME
git\-gpg\-completions \- Emit a shell completion script for the given shell to stdout
.SH SYNOPSIS
\fBgit\-gpg completions\fR [\fB\-h\fR|\fB\-\-help\fR] <\fISHELL\fR> 
.SH DESCRIPTION
Emit a shell completion script for the given shell to stdout
.SH OPTIONS
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
.TP
<\fISHELL\fR>
Shell to generate completions for
.br

.br
\fIPossible values:\fR
.RS 14
.IP \(bu 2
bash
.IP \(bu 2
elvish
.IP \(bu 2
fish
.IP \(bu 2
powershell
.IP \(bu 2
zsh
.RE
