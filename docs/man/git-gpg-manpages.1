.ie \n(.g .ds Aq \(aq
.el .ds Aq '
.TH git-gpg-manpages 1  "git-gpg-manpages " 
.SH NAME
git\-gpg\-manpages \- Write roff man pages (git\-gpg.1 plus one per subcommand) to a directory
.SH SYNOPSIS
\fBgit\-gpg manpages\fR [\fB\-h\fR|\fB\-\-help\fR] [\fIOUTPUT_DIR\fR] 
.SH DESCRIPTION
Write roff man pages (git\-gpg.1 plus one per subcommand) to a directory
.SH OPTIONS
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
.TP
[\fIOUTPUT_DIR\fR]
Directory to write the .1 files into (default: ./man)
